# ParkVega Next.js — Environment Variables
# Copy this file to .env.local and replace placeholder values with real secrets.
# Only NEXT_PUBLIC_* variables are exposed to the browser; secrets must never
# carry that prefix.

# ---------------------------------------------------------------------------
# PARK_VEGA_API_URL
# Server-only base URL of the ParkVega REST API. Route Handlers, Server
# Components and the proxy call it; the browser only calls this app's /api/*.
# (NEXT_PUBLIC_API_URL is still read as a fallback for older environments.)
# ---------------------------------------------------------------------------
PARK_VEGA_API_URL=https://api.parkvega.com

# ---------------------------------------------------------------------------
# FLUTTERWAVE_SECRET_KEY
# Server-only secret key for authenticating server-to-server calls to the
# Flutterwave API (e.g. verifying transactions). Never exposed to the client.
# ---------------------------------------------------------------------------
FLUTTERWAVE_SECRET_KEY=FLWSECK_PLACEHOLDER_REPLACE_WITH_YOUR_SECRET_KEY

# ---------------------------------------------------------------------------
# FLUTTERWAVE_WEBHOOK_HASH
# Server-only hash used to verify the `verif-hash` header on incoming
# Flutterwave webhook requests. The webhook Route Handler compares this value
# against the header before forwarding the payload to the REST API.
# Never exposed to the client.
# ---------------------------------------------------------------------------
FLUTTERWAVE_WEBHOOK_HASH=PLACEHOLDER_REPLACE_WITH_YOUR_WEBHOOK_HASH

# ---------------------------------------------------------------------------
# JWT_SECRET
# Server-only secret used by Edge Middleware to verify the signature of the
# JWT stored in the httpOnly `pv_access` cookie (via the `jose` library).
# Never exposed to the client.
# ---------------------------------------------------------------------------
JWT_SECRET=PLACEHOLDER_REPLACE_WITH_A_STRONG_RANDOM_SECRET

# ---------------------------------------------------------------------------
# NEXT_PUBLIC_HERO_VIDEO_URL (optional)
# Compressed (<3MB) MP4 for the homepage billboard, ideally on a CDN such as
# Cloudinary. When unset, the homepage shows the still hero image instead.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_HERO_VIDEO_URL=

# ---------------------------------------------------------------------------
# NEXT_PUBLIC_ADMIN_URL
# Origin of the staff console (parkvega-admin). The footer's "Staff login"
# link and the /admin and /staff redirects point here.
# Defaults to https://admin.parkvega.com; use http://localhost:3001 locally.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_URL=https://admin.parkvega.com

# ---------------------------------------------------------------------------
# REVALIDATE_SECRET
# Server-only shared secret for POST /api/revalidate, which the staff console
# calls after an edit so public pages refresh immediately. Must match
# REVALIDATE_SECRET in parkvega-admin.
# ---------------------------------------------------------------------------
REVALIDATE_SECRET=PLACEHOLDER_REPLACE_WITH_A_STRONG_RANDOM_SECRET
