# Base URL of the Park Vega API (server-side only, no NEXT_PUBLIC_).
# Kept off the client so the API origin and tokens never leave the server.
PARK_VEGA_API_URL=http://localhost:3000

# This site's public origin. Payment redirects point at ${SITE_URL}/booking/<id>,
# so it must be listed in the API's FRONTEND_ORIGINS.
SITE_URL=http://localhost:3001

# The API's JWT_SECRET. Middleware uses it to read the `role` claim and gate
# /admin. Leave it blank to skip that check (the API still enforces roles).
JWT_SECRET=

# NODE_ENV is set by Next automatically; cookies become Secure in production.
